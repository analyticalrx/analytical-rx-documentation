direction: right

tenant_schema_note: "Tenant schema\nexample: tenant_acme_pharmacy_group\nall tables shown here live together" {
  style.fill: "#f8fafc"
  style.stroke: "#64748b"
  style.stroke-dash: 4
}

tenant_table: {
  shape: sql_table
  label: "tenant"
  id: uuid {constraint: primary_key}
  tenant_key: text
  display_name: text
  status: text
}

pharmacy_table: {
  shape: sql_table
  label: "pharmacy"
  id: uuid {constraint: primary_key}
  tenant_id: uuid {constraint: foreign_key}
  pharmacy_key: text
  source_system: text
  source_pharmacy_id: text
}

drug_table: {
  shape: sql_table
  label: "drug"
  id: uuid {constraint: primary_key}
  tenant_id: uuid {constraint: foreign_key}
  source_system: text
  source_drug_id: text
  ndc: text
  drug_name: text
}

payer_table: {
  shape: sql_table
  label: "payer"
  id: uuid {constraint: primary_key}
  tenant_id: uuid {constraint: foreign_key}
  source_system: text
  source_payer_id: text
  payer_type: text
  payer_bin: text
  payer_pcn: text
}

raw_payload_archive_table: {
  shape: sql_table
  label: "raw_payload_archive"
  id: uuid {constraint: primary_key}
  tenant_id: uuid {constraint: foreign_key}
  pharmacy_id: uuid {constraint: foreign_key}
  raw_payload_reference: text
  raw_payload_sha256: text
}

source_reference_table: {
  shape: sql_table
  label: "source_prescription_reference_restricted"
  id: uuid {constraint: primary_key}
  tenant_id: uuid {constraint: foreign_key}
  pharmacy_id: uuid {constraint: foreign_key}
  rx_no: text {constraint: restricted}
  refill_no: text {constraint: restricted}
  prescription_reference_token: text
  fill_reference_token: text
}

webhook_event_audit_table: {
  shape: sql_table
  label: "webhook_event_audit"
  id: uuid {constraint: primary_key}
  tenant_id: uuid {constraint: foreign_key}
  pharmacy_id: uuid {constraint: foreign_key}
  source_reference_id: uuid {constraint: foreign_key}
  raw_payload_archive_id: uuid {constraint: foreign_key}
  idempotency_key: text
  status: text
}

canonical_event_table: {
  shape: sql_table
  label: "canonical_pharmacy_event"
  id: uuid {constraint: primary_key}
  tenant_id: uuid {constraint: foreign_key}
  pharmacy_id: uuid {constraint: foreign_key}
  audit_event_id: uuid {constraint: foreign_key}
  drug_id: uuid {constraint: foreign_key}
  canonical_event_type: text
  prescription_reference_token: text
  fill_reference_token: text
  bill_type: text
  days_supply: integer
  enrichment_status: text
}

event_payment_table: {
  shape: sql_table
  label: "canonical_event_payer_payment"
  id: uuid {constraint: primary_key}
  tenant_id: uuid {constraint: foreign_key}
  pharmacy_id: uuid {constraint: foreign_key}
  canonical_event_id: uuid {constraint: foreign_key}
  payer_id: uuid {constraint: foreign_key}
  payment_type: text
  payer_sequence: text
  paid_amount: numeric
}

payer_event_link_note: "Payer-event link\nNo payer_id on canonical event\nUse payment.canonical_event_id + payment.payer_id" {
  style.fill: "#fff7ed"
  style.stroke: "#c2410c"
  style.stroke-dash: 4
}

tenant_table.id -> pharmacy_table.tenant_id: "1 to many"
tenant_table.id -> drug_table.tenant_id: "1 to many"
tenant_table.id -> payer_table.tenant_id: "1 to many"
tenant_table.id -> raw_payload_archive_table.tenant_id: "1 to many"
pharmacy_table.id -> raw_payload_archive_table.pharmacy_id: "1 to many"
tenant_table.id -> source_reference_table.tenant_id: "1 to many"
pharmacy_table.id -> source_reference_table.pharmacy_id: "1 to many"
tenant_table.id -> webhook_event_audit_table.tenant_id: "1 to many"
pharmacy_table.id -> webhook_event_audit_table.pharmacy_id: "1 to many"
source_reference_table.id -> webhook_event_audit_table.source_reference_id: "optional"
raw_payload_archive_table.id -> webhook_event_audit_table.raw_payload_archive_id: "optional"
tenant_table.id -> canonical_event_table.tenant_id: "1 to many"
pharmacy_table.id -> canonical_event_table.pharmacy_id: "1 to many"
webhook_event_audit_table.id -> canonical_event_table.audit_event_id: "1 to 1"
drug_table.id -> canonical_event_table.drug_id: "optional"
canonical_event_table.id -> event_payment_table.canonical_event_id: "1 to many"
payer_table.id -> event_payment_table.payer_id: "optional; null for cash"
payer_event_link_note -> event_payment_table: "bridge table"
tenant_schema_note -> tenant_table: "contains"
