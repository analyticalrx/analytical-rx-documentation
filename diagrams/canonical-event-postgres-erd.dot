digraph canonical_event_erd {
  graph [rankdir=LR, splines=ortho, nodesep=0.65, ranksep=1.15, bgcolor="white", pad=0.25];
  node [shape=plain, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=9, color="#475569", arrowsize=0.7];

