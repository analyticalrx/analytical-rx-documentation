direction: right

classes: {
  source: {
    style.fill: "#eef2ff"
    style.stroke: "#4f46e5"
  }
  restricted: {
    style.fill: "#fff7ed"
    style.stroke: "#c2410c"
  }
  safe: {
    style.fill: "#ecfdf5"
    style.stroke: "#047857"
  }
  neutral: {
    style.fill: "#f8fafc"
    style.stroke: "#64748b"
  }
}

primerx: "PrimeRx Webhook / API" {
  class: source
}

receiver: "Webhook Receiver + SQS" {
  class: neutral
}

raw: "Restricted Raw Payload Archive\nS3 pointer + payload hash\nshort retention" {
  class: restricted
}

audit: "ops.webhook_event_audit\nstatus, idempotency, retry state\nno raw PHI payload" {
  class: restricted
}

source_ref: "ops.source_prescription_reference_restricted\nreal RxNo + RefillNo\nbackend-only API lookup" {
  class: restricted
}

drug_lookup: "core.drug\nnormalized drug lookup\nlinked by drug_id" {
  class: safe
}

payer_lookup: "core.payer\nnormalized payer lookup\nlinked through payment rows" {
  class: safe
}

canonical: "analytics.canonical_pharmacy_event\nPHI-minimized event facts\ndrug_id + prescription/fill tokens" {
  class: safe
}

payments: "analytics.canonical_event_payer_payment\npayer-event bridge\ncanonical_event_id + payer_id\ncash uses null payer_id" {
  class: safe
}

dashboards: "Dashboards + Basic Reporting\nquery canonical tables only" {
  class: safe
}

enrichment: "API Enrichment Worker\nuses restricted source reference\nupdates canonical facts" {
  class: neutral
}

primerx -> receiver: "POST event"
receiver -> raw: "optional archive"
receiver -> audit: "receipt + processing audit"
audit -> source_ref: "restricted source IDs"
source_ref -> canonical: "tokens only"
receiver -> drug_lookup: "drug upsert"
receiver -> payer_lookup: "payer upsert"
audit -> canonical: "one processed event"
drug_lookup -> canonical: "drug_id FK"
canonical -> payments: "canonical_event_id FK"
payer_lookup -> payments: "payer_id FK when insurance"
canonical -> dashboards: "safe reads"
payments -> dashboards: "safe payment breakdown"
source_ref -> enrichment: "RxNo / RefillNo"
enrichment -> primerx: "detail lookup"
enrichment -> drug_lookup: "safe drug updates"
enrichment -> payer_lookup: "safe payer updates"
enrichment -> canonical: "safe event enrichment"
enrichment -> payments: "safe payment enrichment"
