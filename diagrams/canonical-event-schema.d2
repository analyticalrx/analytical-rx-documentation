direction: right

classes: {
  source: {
    style.fill: "#eef2ff"
    style.stroke: "#4f46e5"
  }
  restricted: {
    style.fill: "#fff7ed"
    style.stroke: "#c2410c"
  }
  safe: {
    style.fill: "#ecfdf5"
    style.stroke: "#047857"
  }
  neutral: {
    style.fill: "#f8fafc"
    style.stroke: "#64748b"
  }
}

primerx: "PrimeRx Webhook / API" {
  class: source
}

receiver: "Webhook Receiver + SQS" {
  class: neutral
}

tenant_schema: "Tenant Schema Boundary\none schema per tenant\nall tables below live together" {
  class: neutral
}

raw: "Restricted Raw Payload Archive\nS3 pointer + payload hash\nshort retention" {
  class: restricted
}

ingestion_event: "ingestion_event\nstatus, idempotency, retry state\nno raw PHI payload" {
  class: restricted
}

source_ref: "source_rx_reference\nreal RxNo + RefillNo\nbackend-only API lookup" {
  class: restricted
}

drug_lookup: "drug\nnormalized drug lookup\nlinked by drug_id" {
  class: safe
}

payer_lookup: "payer\nnormalized payer lookup\nlinked through payment rows" {
  class: safe
}

pharmacy_event: "pharmacy_event\nPHI-minimized event facts\ndrug_id + prescription/fill tokens" {
  class: safe
}

payments: "event_payment\npayer-event bridge\npharmacy_event_id + payer_id\ncash uses null payer_id" {
  class: safe
}

dashboards: "Dashboards + Basic Reporting\nquery safe event tables only" {
  class: safe
}

enrichment: "API Enrichment Worker\nuses restricted source reference\nupdates canonical facts" {
  class: neutral
}

primerx -> receiver: "POST event"
receiver -> tenant_schema: "select by authenticated tenant context"
receiver -> raw: "optional archive"
receiver -> ingestion_event: "receipt + processing status"
ingestion_event -> source_ref: "restricted source IDs"
source_ref -> pharmacy_event: "tokens only"
receiver -> drug_lookup: "drug upsert"
receiver -> payer_lookup: "payer upsert"
ingestion_event -> pharmacy_event: "one processed event"
drug_lookup -> pharmacy_event: "drug_id FK"
pharmacy_event -> payments: "pharmacy_event_id FK"
payer_lookup -> payments: "payer_id FK when insurance"
pharmacy_event -> dashboards: "safe reads"
payments -> dashboards: "safe payment breakdown"
source_ref -> enrichment: "RxNo / RefillNo"
enrichment -> primerx: "detail lookup"
enrichment -> drug_lookup: "safe drug updates"
enrichment -> payer_lookup: "safe payer updates"
enrichment -> pharmacy_event: "safe event enrichment"
enrichment -> payments: "safe payment enrichment"
